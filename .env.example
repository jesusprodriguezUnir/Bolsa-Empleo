# Copia este fichero a .env para pruebas en local (NO lo subas al repo).
# En GitHub se configuran como "Secrets" del repositorio, no con .env.

# Cuenta Gmail que ENVÍA el correo
GMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación de 16 caracteres (NO tu contraseña normal de Gmail).
# Se genera en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Destinatario de las alertas (puede ser el mismo correo)
MAIL_TO=jesusprodriguez@gmail.com

# Opcional: fuerza el envío aunque no haya novedades (true/false). Por defecto true.
SEND_ALWAYS=true
